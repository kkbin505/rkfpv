#!/bin/sh
# Boot: pick the USB role, bring up wfb-ng (+ MAVLink), start rkfpv.
#
# USB is a single OTG port:
#   - plugged into a PC (gadget gets "configured")  -> stay a device so ADB /
#     RNDIS work; FPV link is not started (debug mode)
#   - anything else (RTL8812AU on an OTG adapter)   -> switch to host, start FPV
# Override: touch /userdata/fpv.force (always FPV) or /userdata/fpv.off (never).

OTG_MODE=/sys/devices/platform/ff3e0000.usb2-phy/otg_mode
PIDFILE=/var/run/rkfpv.pid

log() { echo "$1" | logger -s -t fpv; }

pc_connected() {
	# give the host PC a few seconds to enumerate the gadget
	for i in 1 2 3 4; do
		for s in /sys/class/udc/*/state; do
			[ "$(cat "$s" 2>/dev/null)" = "configured" ] && return 0
		done
		sleep 1
	done
	return 1
}

start() {
	if [ -e /userdata/fpv.off ]; then
		log "/userdata/fpv.off present, FPV not started"
		return 0
	fi
	if [ ! -e /userdata/fpv.force ] && pc_connected; then
		log "PC on USB: staying in device mode (ADB/RNDIS), FPV not started"
		return 0
	fi

	if [ -w "$OTG_MODE" ]; then
		echo host > "$OTG_MODE"
		log "USB switched to host"
	fi

	/usr/bin/wfb.sh start

	start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/rkfpv -- -c /etc/rkfpv.conf
}

stop() {
	start-stop-daemon -K -q -p "$PIDFILE" -s TERM
	/usr/bin/wfb.sh stop
}

case "$1" in
	start|stop) "$1" ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
